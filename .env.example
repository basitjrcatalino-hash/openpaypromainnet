# Bags API (server-only  copy to .env, never commit real values)
BAGS_API_KEY=
BAGS_USER_UUID=
# Partner config PDA from Bags dashboard + fee wallet
BAGS_PARTNER_CONFIG=
BAGS_PARTNER_WALLET=
BAGS_PARTNER_REF=mrwain
BAGS_PARTNER_REF_URL=https://bags.fm/?ref=mrwain
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana Commerce Kit (PaymentButton + Solana Pay)
# https://solana.com/docs/tools/commerce-kit/quickstart/wallet-connection
# https://solana.com/docs/tools/commerce-kit/quickstart/payment-button
# https://solana.com/docs/tools/commerce-kit/quickstart/solana-pay
VITE_SOLANA_MERCHANT_NAME=OpenPay Pro
VITE_SOLANA_MERCHANT_WALLET=
VITE_SOLANA_NETWORK=mainnet
VITE_SOLANA_RPC_URL=
# Optional  Phantom-style live chat GIF/Meme picker (https://klipy.com/developers)
VITE_KLIPY_API_KEY=

# Web Push (lock-screen / notification center)  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@openpy.space

# Email transaction alerts  Lovable Cloud email (preferred on Lovable deploy)
# LOVABLE_API_KEY is injected by Lovable; set locally if testing email off-platform.
LOVABLE_API_KEY=
# Optional override for Lovable send endpoint
# LOVABLE_SEND_URL=
# Optional From override (otherwise RESEND_FROM_EMAIL / default)
# LOVABLE_FROM_EMAIL=OpenPay Pro <noreply@openpy.space>

# Fallback: Resend (https://resend.com) if Lovable email is unavailable
# Verify domain openpy.space in Resend for @openpy.space From addresses.
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenPay Pro <noreply@openpy.space>
APP_URL=https://openpaypro.space

# OpenPay Partner KYC (reviewed at OpenPay /admin-kyc-review)
# Create key in OpenPay  /partner-api (opk_live_). Never expose to the browser.
# Webhook: https://openpaypro.space/api/public/openpay/kyc-webhook
OPENPAY_KYC_API_KEY=
# Optional override (defaults to OpenPay production kyc-partner-api)
# OPENPAY_KYC_API_BASE=https://araojncyittkahvvpdrn.supabase.co/functions/v1/kyc-partner-api

# Catch-all tx emails: /api/webhooks/transactions (also used by DB trigger migration)
# After applying 20260731180000_tx_email_webhook_trigger.sql, enable in SQL editor:
#   UPDATE public.tx_email_webhook_config
#   SET secret = '<same as TX_WEBHOOK_SECRET>', enabled = true WHERE id = 1;
TX_WEBHOOK_SECRET=

# MoonPay Commerce (Helio) Deposit
HELIO_API_KEY=
HELIO_SECRET_KEY=
HELIO_DEPOSIT_ID=6a6ac63aec05a9b4c060e59b
HELIO_RECIPIENT_WALLET=FX8VyDp7SMbnUpn6D1KbjSvQv9VBybQ2cchHrSE4dReR
HELIO_DEPOSIT_CUSTOMER_TOKEN=
HELIO_WEBHOOK_SHARED_TOKEN=
HELIO_USDC_DEPOSIT_ID=6a6ac77cec05a9b4c060eaca
HELIO_USDC_DEPOSIT_CUSTOMER_TOKEN=

# Circle Programmable Wallets + Circle Mint deposits
# Developer Console: TEST_API_KEY (Wallets), TEST_CLIENT_KEY, KIT_KEY
# Circle Mint deposits need a Mint-enabled API key (payments)  Wallets keys alone get 401/403
CIRCLE_API_KEY=
# Optional: frontend / kit credentials (not used by Mint REST server path)
# CIRCLE_CLIENT_KEY=
# CIRCLE_KIT_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Wallets keys usually use https://api.circle.com even with TEST_API_KEY: prefix
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_BLOCKCHAIN=ETH-SEPOLIA
# CIRCLE_WEBHOOK_PUBLIC_KEY=
# CIRCLE_WEBHOOK_SKIP_VERIFY=false
# Mint merchant wallet id (required for some entities)
CIRCLE_MINT_MERCHANT_WALLET_ID=
CIRCLE_MINT_CHAIN=ETH
# Only set when using a sandbox Mint key:
# CIRCLE_MINT_BASE_URL=https://api-sandbox.circle.com
# CIRCLE_PURPOSE_OF_TRANSFER=PMT001
WALLET_PROVIDER=circle

# Resend transaction emails (server)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=OpenPay Pro <noreply@openpy.space>
# APP_URL=https://openpaypro.space

# Phantom Connect (https://phantom.com/portal)  App ID is client-safe
# Docs: https://docs.phantom.com/sdks/react-sdk
VITE_PHANTOM_APP_ID=42ba7350-53ef-4b1e-aba6-43f7905b094e
# Must match an allowlisted Redirect URL in Phantom Portal (optional override)
# VITE_PHANTOM_REDIRECT_URL=https://openpaypro.space/auth/callback

# Banxa Hosted Checkout (Apple Pay / Google Pay / Cards / Bank Transfer)
# Docs: https://docs.banxa.com/products/hosted-checkout/docs/api-integration/create-buy-order
# Payment guides: apple-pay  google-pay  cards  bank-transfer (Native API)
# BANXA_ENV=sandbox|production
BANXA_API_KEY=
BANXA_PARTNER=
BANXA_SETTLEMENT_WALLET=
BANXA_ENV=sandbox
# BANXA_BASE_URL=https://api.banxa-sandbox.com
BANXA_FIAT=USD
BANXA_CRYPTO=USDC
BANXA_BLOCKCHAIN=ETH
# Bank rail override (default by fiat: USDACH, EURSEPA, GBPFaster Payments, AUDPayID)
# BANXA_BANK_PAYMENT_METHOD_ID=ach-bank-transfer
# Webhook: https://<host>/api/public/banxa-webhook
# BANXA_WEBHOOK_SECRET=

# Trust Wallet API (https://tws.trustwallet.com)  server-only
# Portal: https://portal.trustwallet.com/dashboard/docs
# Skills: https://github.com/trustwallet/tw-agent-skills
TW_ACCESS_ID=
TW_HMAC_SECRET=
# TWAK_ACCESS_ID=
# TWAK_HMAC_SECRET=
# TW_API_BASE=https://tws.trustwallet.com
