# Email transaction alerts via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenPay Pro <noreply@openpy.space>
APP_URL=https://openpaypro.space

# Optional Supabase Database Webhook secret for /api/webhooks/transactions
TX_WEBHOOK_SECRET=

